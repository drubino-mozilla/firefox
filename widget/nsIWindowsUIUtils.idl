#include "nsISupports.idl"

interface mozIDOMWindowProxy;
interface imgIContainer;

[scriptable, builtinclass, uuid(5b3c9a41-7e2d-4f6b-9c58-2d1e8a7f4b90)]
interface nsIWindowsUIUtils : nsISupports
{
  readonly attribute long systemSmallIconSize;
  readonly attribute long systemLargeIconSize;

  void setWindowIcon(in mozIDOMWindowProxy aWindow, in imgIContainer aSmallIcon, in imgIContainer aLargeIcon);

  void setWindowIconFromExe(in mozIDOMWindowProxy aWindow, in AString aExe, in unsigned short aIndex);

  void setWindowIconNoData(in mozIDOMWindowProxy aWindow);

  /**
   * Whether the OS is currently in Win10's Tablet Mode. Always false on
   * versions of Windows other than Win10.
   *
   * (Win10 tablet mode is sufficiently different from Win11 tablet mode that
   * there is no single getter to retrieve whether we're in a generic "tablet
   * mode".)
   */
  readonly attribute boolean inWin10TabletMode;

  /**
   * Whether the OS is currently in Windows 11's tablet mode. Always false on
   * versions of Windows prior to Win11.
   *
   * (Win11 tablet mode is sufficiently different from Win10 tablet mode that
   * there is no single getter to retrieve whether we're in a generic "tablet
   * mode".)
   */
  readonly attribute boolean inWin11TabletMode;

  /**
   * Whether this device is believed to be capable of entering tablet mode at
   * all, regardless of whether it happens to be in tablet mode right now.
   *
   * Always true on Win10, where tablet mode is a user-toggleable setting on
   * every device; determined heuristically on Win11 and later, where there is
   * no documented way to ask.
   *
   * Prefer this over the inWin*TabletMode getters when deciding whether to
   * offer tablet-mode-related UI: those report momentary state, so they are
   * false on a convertible that merely isn't folded at the moment, and they can
   * change while that UI is open.
   */
  readonly attribute boolean isTabletCapable;

  /**
   * Share URL
   */
  void shareUrl(in AString urlToShare, in AString shareTitle);

  /**
   * Docks aWindow to the top edge of its screen as an appbar, a desktop
   * toolbar like the taskbar that the shell keeps other windows out of,
   * reserving a strip aHeight device pixels tall. Calling it again changes the
   * height of the strip. The window becomes a borderless tool window, hides
   * while a full screen app is in front, and outside the reserved strip and the
   * regions set with setAppBarHitRegions is see-through and lets clicks through.
   */
  void dockAsAppBar(in mozIDOMWindowProxy aWindow, in long aHeight);

  /**
   * Sets the height of an appbar window in device pixels. It may extend below
   * the reserved strip.
   */
  void setAppBarWindowHeight(in mozIDOMWindowProxy aWindow, in long aHeight);

  /**
   * Sets the parts of an appbar window below its reserved strip that take
   * clicks, as consecutive (x, y, width, height, corner radius) values in
   * device pixels relative to the window.
   */
  void setAppBarHitRegions(in mozIDOMWindowProxy aWindow,
                           in Array<long> aRegions);

  void undockAppBar(in mozIDOMWindowProxy aWindow);
};
