### Strings for the notification area icon shown while the browser keeps
### running in the background with no windows open.

# Title of the hidden window that hosts the notification area icon. Never shown
# to users, but required for the window to be identifiable.
background-mode-tray-title = { -brand-short-name } background session

# Tooltip of the notification area icon.
background-mode-tray-menu =
    .label = { -brand-short-name } is running in the background

background-mode-new-window =
    .label = New window

background-mode-new-private-window =
    .label = New private window

background-mode-quit =
    .label = Quit { -brand-short-name }
