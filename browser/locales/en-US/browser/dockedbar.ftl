## Docked address bar: an address bar docked to the top edge of the screen,
## outside any Firefox window.

dockedbar-toggle-button =
    .label = Docked address bar
    .tooltiptext = Show or hide the address bar at the top of your screen

dockedbar-new-tab-button =
    .label = New tab
    .tooltiptext = Open a new tab

dockedbar-close-button =
    .label = Close docked address bar
    .tooltiptext = Close docked address bar
